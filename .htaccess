# Redirect public aliases directly to the canonical HTTPS address.
RewriteEngine On
RewriteCond %{THE_REQUEST} "\s/+reklama/(?:index\.html)?(?:[?\s])" [NC]
RewriteRule ^reklama/(?:index\.html)?$ https://romanulin.ru/reklama [R=301,L]

# THE_REQUEST preserves percent-encoded path characters in redirect targets.
RewriteCond %{THE_REQUEST} "\s/+([^?\s]*/)?index\.html(?:[?\s])" [NC]
RewriteRule ^(?:.*/)?index\.html$ https://romanulin.ru/%1 [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^www\.romanulin\.ru(?::[0-9]+)?$ [NC]
RewriteCond %{THE_REQUEST} "\s(/[^?\s]*)(?:\?[^\s]*)?\s"
RewriteRule ^ https://romanulin.ru%1 [R=301,L,NE]

# This page intentionally uses the extensionless URL without a trailing slash.
RewriteRule ^reklama$ reklama/index.html [END]

# Avoid mod_dir producing an HTTP redirect behind the hosting HTTPS proxy.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{THE_REQUEST} "\s(/[^?\s]*[^/?\s])(?:\?[^\s]*)?\s"
RewriteRule ^ https://romanulin.ru%1/ [R=301,L,NE]

# Revalidate HTML; cache versionless assets briefly so updates remain visible.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType text/javascript "access plus 1 hour"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Defense in depth. The live config/cache must still be OUTSIDE public_html.
<FilesMatch "^(\.env.*|tgstat-config.*\.php)$">
    Require all denied
</FilesMatch>
